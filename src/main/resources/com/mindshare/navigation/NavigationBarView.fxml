<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindshare.navigation.NavigationBarController"
      styleClass="web-navbar" alignment="CENTER_LEFT" spacing="18">
    <HBox fx:id="navLinks" spacing="18" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
        <Button text="Dashboard" onAction="#handleDashboard" styleClass="nav-link" />
        <Button text="Groups" onAction="#handleGroups" styleClass="nav-link" />
        <Button text="Quiz" onAction="#handleQuiz" styleClass="nav-link" />
        <Button text="Recommended" onAction="#handleRecommended" styleClass="nav-link" />
        <Button fx:id="manageUsersButton" text="Manage Users" onAction="#handleManageUsers" styleClass="nav-link" visible="false" managed="false" />
        <Button fx:id="statisticsButton" text="Statistics" onAction="#handleStatistics" styleClass="nav-link" visible="false" managed="false" />
        <Button fx:id="participationButton" text="Participation" onAction="#handleParticipation" styleClass="nav-link" visible="false" managed="false" />
    </HBox>
    <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="nav-right-cluster">
        <fx:include source="../notification/NotificationBellView.fxml" />
        <fx:include source="UserMenuView.fxml" />
    </HBox>
</HBox>
