<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindshare.quiz.QuizConfigurationController">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <Label text="Quiz Configuration" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TextField fx:id="titleField" promptText="Quiz Title" prefWidth="300"/>
    <TextField fx:id="dateField" promptText="Date (yyyy-MM-dd HH:mm)" prefWidth="300"/>
    <TextField fx:id="durationField" promptText="Duration (minutes)" prefWidth="300"/>
    <ComboBox fx:id="categoryBox" promptText="Target Category" prefWidth="300"/>

    <Label fx:id="statusLabel" style="-fx-text-fill: red;" visible="false"/>

    <Button fx:id="saveButton" text="Save" onAction="#handleSave"/>
    <Button fx:id="backButton" text="Back to Dashboard" onAction="#handleBack"/>
</VBox>