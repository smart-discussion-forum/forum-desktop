<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="root"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindshare.quiz.QuizConfigurationController">
    <content>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: transparent;">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <!-- Main White Card Container -->
            <VBox styleClass="page-card" maxWidth="780" spacing="20">
                <padding>
                    <Insets top="32" right="40" bottom="32" left="40"/>
                </padding>

                <!--Header Title -->
                <Label text="Quiz configuration" styleClass="screen-title" alignment="CENTER" maxWidth="Infinity"/>


                <HBox alignment="CENTER" spacing="12">
                    <Button text="Back to Quizzes" onAction="#handleBack" styleClass="button"/>
                    <Button text="Dashboard" onAction="#handleDashboard" styleClass="button"/>
                    <Button text="Group Chat" onAction="#handleGroupChat" styleClass="button"/>
                </HBox>


                <VBox spacing="16">
                    <VBox spacing="6">
                        <Label text="Quiz Title:" styleClass="form-field-label"/>
                        <TextField fx:id="titleField" styleClass="text-field"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Date:" styleClass="form-field-label"/>
                        <DatePicker fx:id="datePicker" promptText="dd/mm/yyyy --:--" maxWidth="Infinity" styleClass="date-picker"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Duration (minutes):" styleClass="form-field-label"/>
                        <TextField fx:id="durationField" styleClass="text-field"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Group:" styleClass="form-field-label"/>
                        <ComboBox fx:id="categoryBox" promptText="-- Select a group --" styleClass="combo-box-base" maxWidth="Infinity"/>
                    </VBox>
                </VBox>
                <VBox spacing="12" style="-fx-padding: 10 0 0 0;">
                    <Label text="Questions:" styleClass="form-field-label"/>

                    <VBox fx:id="questionsContainer" spacing="14"/>

                    <HBox alignment="CENTER_LEFT">
                    <Button fx:id="addQuestionButton" text="+ Add Question" onAction="#addQuestion" styleClass="button"/>
                    </HBox>
                </VBox>

                <Label fx:id="statusLabel" styleClass="error;" visible="false"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="saveButton" text="Save Quiz" onAction="#handleSave" styleClass="nav-logout"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>