<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindshare.quiz.QuizResultsController">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <Label text="Quiz Results" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label fx:id="scoreLabel" style="-fx-font-size: 16px;"/>
    <Label fx:id="gradeLabel" style="-fx-font-size: 16px;"/>
    <Label fx:id="feedbackLabel" wrapText="true"/>

    <Button fx:id="doneButton" text="Back to Dashboard" onAction="#handleDone"/>
</VBox>