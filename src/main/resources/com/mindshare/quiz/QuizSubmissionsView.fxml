<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="TOP_CENTER" spacing="18" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.mindshare.quiz.QuizSubmissionsController">
    <padding><Insets top="24" right="24" bottom="30" left="24" /></padding>
    <VBox styleClass="page-card" maxWidth="900" spacing="16">
        <padding><Insets top="26" right="30" bottom="26" left="30" /></padding>
        <Label fx:id="titleLabel" styleClass="screen-title" />
        <Label fx:id="countLabel" styleClass="page-subtitle" />
        <TableView fx:id="submissionsTable" prefHeight="400">
            <columns>
                <TableColumn fx:id="studentColumn" text="Student" prefWidth="260" />
                <TableColumn fx:id="scoreColumn" text="Score" prefWidth="180" />
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="220" />
            </columns>
        </TableView>
        <Label fx:id="statusLabel" styleClass="admin-status" />
        <Button text="Back to Quiz" onAction="#handleBack" />
    </VBox>
</VBox>
