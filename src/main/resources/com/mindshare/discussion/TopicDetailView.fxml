<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindshare.discussion.controller.TopicDetailController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label fx:id="topicTitleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <ListView fx:id="postsListView" prefWidth="450" prefHeight="220"/>

    <TextArea fx:id="replyField" promptText="Write a reply..." prefWidth="450" prefHeight="60"/>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="sendButton" text="Send" onAction="#handleSend"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"/>
        <Button fx:id="exportButton" text="Export Discussion" onAction="#handleExport"/>
    </HBox>

    <Button fx:id="backButton" text="Back to Topics" onAction="#handleBack"/>
</VBox>