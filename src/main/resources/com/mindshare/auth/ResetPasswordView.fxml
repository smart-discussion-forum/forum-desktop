<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindshare.auth.controller.PasswordResetController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Reset Password" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Enter your email and choose a new password." wrapText="true" maxWidth="300"
           style="-fx-text-alignment: center;"/>

    <TextField fx:id="emailField" promptText="Email" maxWidth="250"/>
    <PasswordField fx:id="passwordField" promptText="New password (at least 8 characters)" maxWidth="250"/>
    <PasswordField fx:id="confirmationField" promptText="Confirm new password" maxWidth="250"/>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;" visible="false" wrapText="true" maxWidth="300"/>

    <Button fx:id="resetButton" text="Reset Password" onAction="#handleReset" prefWidth="150"/>
    <Button text="Back to Login" onAction="#handleBackToLogin" maxWidth="150"
            style="-fx-background-color: transparent; -fx-text-fill: #2f5f84; -fx-effect: none;"/>
</VBox>
