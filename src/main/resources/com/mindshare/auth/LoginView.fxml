<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindshare.auth.controller.LoginController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text ="LogIn" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TextField fx:id="usernameField" promptText="Email" maxWidth="250"/>
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="250"/>

    <Button text="Forgot password?" onAction="#handleForgotPassword" maxWidth="250"
            style="-fx-background-color: transparent; -fx-text-fill: #2f5f84; -fx-effect: none; -fx-padding: 0;"/>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;" visible="false"/>
    <Label fx:id="statusLabel" style="-fx-text-fill: #067647;" visible="false" wrapText="true" maxWidth="300"/>

    <Button fx:id="loginButton" text="LogIn" onAction="#handleLogin" prefWidth="120"/>
</VBox>
