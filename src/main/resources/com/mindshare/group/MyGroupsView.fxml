<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindshare.group.MyGroupsController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="My Groups" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label fx:id="statusLabel" style="-fx-text-fill: red;" visible="false"/>

    <ListView fx:id="groupListView" prefWidth="400" prefHeight="280"/>

    <Button fx:id="backButton" text="Back to Dashboard" onAction="#handleBack"/>
</VBox>