<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="18" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindshare.group.CreateGroupController"
      styleClass="page-card"
      maxWidth="600">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <Label text="Create a New Group" styleClass="screen-title"/>

    <Label text="Group Name:" styleClass="form-field-label"/>
    <TextField fx:id="nameField" promptText="e.g. Algorithms Study Group" maxWidth="Infinity"/>

    <Label text="Description:" styleClass="form-field-label"/>
    <TextArea fx:id="descriptionField" promptText="Optional description" prefRowCount="4" wrapText="true" maxWidth="Infinity"/>

    <Label fx:id="statusLabel" visible="false" managed="false" wrapText="true" styleClass="error"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="backButton" text="Cancel" onAction="#handleBack"/>
        <Button fx:id="createButton" text="Create Group" onAction="#handleCreate" styleClass="nav-logout"/>
    </HBox>
</VBox>
