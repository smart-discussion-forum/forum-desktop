<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindshare.group.GroupDetailController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label fx:id="groupNameLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="searchField" promptText="Search topics" prefWidth="250"/>
        <Button text="Search" onAction="#handleSearch"/>
    </HBox>

    <ListView fx:id="topicListView" prefWidth="400" prefHeight="240"/>

    <Button fx:id="createTopicButton" text="Create Topic" onAction="#handleCreateTopic"/>
    <Button fx:id="backButton" text="Back to My Groups" onAction="#handleBack"/>
</VBox>