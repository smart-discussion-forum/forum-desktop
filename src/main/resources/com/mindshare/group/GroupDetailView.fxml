<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindshare.group.GroupDetailController"
      style="-fx-background-color: #e9ecef;"
      stylesheets="@../style.css">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <BorderPane maxWidth="1000">
        <left>
            <VBox spacing="6">
                <Label fx:id="groupNameLabel" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Browse topic summaries, see the latest discussion snippet, and jump into a thread."
                       style="-fx-text-fill: #6c757d; -fx-font-size: 13px;"/>
            </VBox>
        </left>
        <right>
            <Button fx:id="backButton" text="Back to Group Chat" onAction="#handleBack"
                    style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 8 18; -fx-font-size: 13px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 4, 0, 0, 1);"/>
        </right>
    </BorderPane>

    <Button fx:id="createTopicButton" text="New topic" onAction="#handleCreateTopic"
            style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 8 22; -fx-font-size: 13px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 4, 0, 0, 1);"/>

    <VBox maxWidth="1000" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <TableView fx:id="topicTableView" prefWidth="980" prefHeight="380" id="topicTable"
                   style="-fx-background-color: transparent; -fx-selection-bar: #eef2ff; -fx-selection-bar-non-focused: #eef2ff; -fx-text-fill: #1a1a1a;">
                <columns>
                <TableColumn fx:id="topicColumn" text="TOPIC" prefWidth="240"/>
                <TableColumn fx:id="categoryColumn" text="CATEGORY" prefWidth="140"/>
                <TableColumn fx:id="creatorColumn" text="CREATED BY" prefWidth="160"/>
                <TableColumn fx:id="repliesColumn" text="REPLIES" prefWidth="90"/>
                <TableColumn fx:id="latestColumn" text="LATEST DISCUSSION" prefWidth="240"/>
                <TableColumn fx:id="actionColumn" text="ACTION" prefWidth="110"/>
            </columns>
        </TableView>
    </VBox>
</VBox>