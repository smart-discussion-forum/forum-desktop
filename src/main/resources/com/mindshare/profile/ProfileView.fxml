<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="TOP_CENTER" spacing="14" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindshare.profile.ProfileController"
      styleClass="page-card">
    <padding><Insets top="34" right="34" bottom="34" left="34" /></padding>
    <Label text="Profile" styleClass="screen-title" />
    <Label fx:id="nameLabel" />
    <Label fx:id="emailLabel" />
    <Label fx:id="roleLabel" />
    <Label fx:id="statusLabel" styleClass="admin-status" />
    <VBox spacing="10" alignment="CENTER">
        <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh" />
        <Button fx:id="backButton" text="Back to Dashboard" onAction="#handleBack" />
    </VBox>
</VBox>
