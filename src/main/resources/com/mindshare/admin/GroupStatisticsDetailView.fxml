<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="18" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.mindshare.admin.GroupStatisticsDetailController">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="GROUP OVERVIEW" styleClass="eyebrow-label"/>
            <Label fx:id="nameLabel" styleClass="screen-title" style="-fx-font-size: 22px;"/>
            <Label fx:id="subtitleLabel" styleClass="group-card-subtitle" wrapText="true"/>
        </VBox>
        <Button fx:id="backButton" text="All groups" onAction="#handleBack"/>
    </HBox>

    <Label fx:id="statusLabel" styleClass="admin-status"/>

    <HBox fx:id="statsRow" spacing="12"/>

    <HBox spacing="16">
        <VBox fx:id="mostActiveBox" styleClass="info-box" HBox.hgrow="ALWAYS">
            <Label text="MOST ACTIVE TOPIC" styleClass="info-box-title"/>
            <Label fx:id="mostActiveTitleLabel" styleClass="info-box-topic" wrapText="true"/>
            <Label fx:id="mostActivePostsLabel" styleClass="group-card-subtitle"/>
        </VBox>
        <VBox fx:id="leastActiveBox" styleClass="info-box" HBox.hgrow="ALWAYS">
            <Label text="LEAST ACTIVE TOPIC" styleClass="info-box-title"/>
            <Label fx:id="leastActiveTitleLabel" styleClass="info-box-topic" wrapText="true"/>
            <Label fx:id="leastActivePostsLabel" styleClass="group-card-subtitle"/>
        </VBox>
    </HBox>

    <Label text="All topics" style="-fx-font-size: 16px; -fx-font-weight: 600;"/>

    <TableView fx:id="topicsTable" prefHeight="260" prefWidth="1100" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="topicTitleColumn" text="Topic" prefWidth="440"/>
            <TableColumn fx:id="topicCategoryColumn" text="Category" prefWidth="220"/>
            <TableColumn fx:id="topicPostsColumn" text="Posts" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
