<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindshare.admin.ParticipationStatisticsController">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <Label text="Participation Statistics" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="searchField" promptText="Search user" prefWidth="200"/>
        <Button text="Search" onAction="#handleSearch"/>
    </HBox>

    <TableView fx:id="statsTable" prefWidth="400" prefHeight="240">
        <columns>
            <TableColumn fx:id="userColumn" text="User" prefWidth="200"/>
            <TableColumn fx:id="postsColumn" text="Posts" prefWidth="100"/>
            <TableColumn fx:id="scoreColumn" text="Score" prefWidth="100"/>
        </columns>
    </TableView>

    <Button fx:id="exportButton" text="Export" onAction="#handleExport"/>
    <Button fx:id="backButton" text="Back" onAction="#handleBack"/>
</VBox>