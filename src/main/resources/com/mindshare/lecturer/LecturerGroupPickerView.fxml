<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.mindshare.lecturer.LecturerGroupPickerController">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="STUDENT PARTICIPATION" styleClass="eyebrow-label"/>
            <Label text="Your groups" styleClass="screen-title" style="-fx-font-size: 22px;"/>
            <Label text="Pick a group to see participation marks for each student."
                   styleClass="group-card-subtitle" wrapText="true"/>
        </VBox>
        <Button fx:id="backButton" text="Back" onAction="#handleBack"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search by group name..." prefWidth="300" onAction="#handleSearch"/>
        <Button text="Search" onAction="#handleSearch"/>
    </HBox>

    <Label fx:id="statusLabel" styleClass="admin-status"/>

    <ScrollPane fitToWidth="true" prefHeight="520" prefWidth="1100" VBox.vgrow="ALWAYS">
        <VBox fx:id="cardsContainer" spacing="16"/>
    </ScrollPane>
</VBox>
